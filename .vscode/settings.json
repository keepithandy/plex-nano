{
  "python.defaultInterpreterPath": "${workspaceFolder}/training/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/training/src"
  ],
  "terminal.integrated.cwd": "${workspaceFolder}",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json",
    "pyproject.toml": "uv.lock"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/node_modules": true,
    "**/dist": true,
    "training/artifacts": true,
    "**/*.egg-info": true
  },
  "search.exclude": {
    "training/phase2/drafts/**": true,
    "training/phase2/data/**": true,
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "training/artifacts/**": true
  }
}
